# ──────────────────────────────────────────────
# AuRE – environment configuration
# Copy this file to .env and fill in the values.
#
# AuRE reads these from (highest precedence first):
#   1. the real shell environment
#   2. a project-local .env (this file)
#   3. ~/.aure — same KEY=value format, machine-wide defaults
# So you can keep shared config in ~/.aure and override per-project in .env.
# ──────────────────────────────────────────────

# ── LLM provider ────────────────────────────
# Supported: "openai", "gemini", "alcf", "local" (Ollama / LM Studio / vLLM)
# If unset, AuRE auto-detects from whichever API key is present.
LLM_PROVIDER=openai

# ── API key ─────────────────────────────────
# Generic key (works for any provider):
LLM_API_KEY=sk-...
# Or use the provider-specific variable instead:
# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=...

# ── Model name ──────────────────────────────
# Defaults: openai → gpt-4o-mini, gemini → gemini-2.0-flash-lite,
#           alcf → gpt-oss-120b, local → llama3
LLM_MODEL=gpt-4o-mini

# ── Base URL (local / OpenAI-compatible only) ─
# Uncomment and set when using Ollama, LM Studio, vLLM, etc.
# LLM_BASE_URL=http://localhost:11434/v1

# ── Generation settings ─────────────────────
LLM_TEMPERATURE=0.0
LLM_TIMEOUT=120          # seconds to wait per LLM call
# Retries per LLM call on a transient failure. Matters against a local server:
# Ollama evicts an idle model after ~5 min and AuRE's fits run longer, so the
# call after a fit often arrives mid-reload. Set 0 to fail fast.
LLM_MAX_RETRIES=2

# ── ALCF inference endpoints ────────────────
# Set LLM_PROVIDER=alcf to use Argonne Leadership Computing Facility models.
# Docs: https://docs.alcf.anl.gov/services/inference-endpoints/
# ALCF_CLUSTER=sophia         # "sophia" (vLLM) or "metis" (SambaNova)
# ALCF_ACCESS_TOKEN=...       # Globus token – if unset, AuRE runs
#                              # inference_auth_token.py get_access_token
#
# Globus app / gateway IDs (defaults match the ALCF inference-endpoints repo;
# override only if ALCF publishes new client IDs).
# GLOBUS_APP_NAME=inference_app
# GLOBUS_AUTH_CLIENT_ID=
# GLOBUS_GATEWAY_CLIENT_ID=
# GLOBUS_GATEWAY_SCOPE=

# ── Fitting ──────────────────────────────────
# Method: "lm" (Levenberg-Marquardt, fast), "de" (Differential Evolution),
#         "dream" (MCMC with uncertainty quantification)
FIT_METHOD=dream
FIT_STEPS=1000             # number of MCMC / optimizer steps
FIT_BURN=1000              # burn-in steps (DREAM only)

# Thin-layer SLD mode enumeration (single-file fits, opt-in, default off).
# Thin layers sit on a Δρ·t degeneracy ridge with distinct SLD modes a single
# optimizer run cannot cross. When enabled, each thin layer's SLD is re-seeded
# across discrete levels and cheaply polished, and the main fit starts from the
# best basin.
MODE_ENUMERATION=0         # 1/true/on to enable
THIN_LAYER_MODE_K=1.0      # "thin" = thickness < K × (2π / Q_max)
THIN_LAYER_MODE_SEEDS=3    # discrete SLD seeds tried per thin layer

# Let the data file's free-form run title (e.g. "# Run title: CuPt_d8-THF...")
# influence the analysis. The title is ALWAYS extracted and checkpointed; this
# flag only decides whether it is interpreted, as extra ranked structural
# hypotheses that the refinement loop can reject. Off by default: it changes
# results for every existing run, and a wrong title in a multi-state
# co-refinement can mislabel which state is which contrast.
USE_RUN_TITLE=0            # 1/true/on to enable

# Upper bound (Å) for the OUTERMOST interface roughness in back reflection —
# the boundary between the ambient and the topmost layer. Normally taken from
# that layer's own `roughness_max` (default 30 Å); set this to force a value for
# batch runs. A solvent-swollen SEI is genuinely diffuse: against expert
# reference fits its outer roughness exceeds 30 Å in most measured runs.
# ROUGHNESS_MAX_OUTER=250

# ── Evaluation ───────────────────────────────
# Upper end of the χ² acceptance window: a finite χ² at or below it is accepted in
# code (not at the evaluator LLM's discretion) and the refinement loop stops
# immediately, with the untried structural hypotheses reported instead. It does
# NOT force acceptance when the SLD-profile artifact check found a non-physical
# excursion; when that check could not VERIFY the profile — none was exported, the
# detector declined it, or the fit is MULTI-STATE, since only states[0]'s profile
# is read back, so the stop is inert for co-refinement; or when a per-file/
# per-state χ² is over the threshold on its own. In each of those the evaluator
# LLM's verdict decides instead, as it did before the stop existed.
# Precedence on a fresh run: a setup YAML's `chi2_max:` (for that run) > a
# CHI2_MAX already exported in your shell > this file > the built-in fallback of
# 5.0. There is no CLI flag. The 2.5 below is this file's value, not the built-in
# default. `aure resume` ignores all of the above: the window is pinned into the
# run state on the first pass and the resumed run keeps it.
CHI2_MAX=2.5

# Lower end of that window. Below it the stop STANDS DOWN — the evaluator LLM's
# verdict decides — rather than force-accepting, so a genuinely good fit whose dR
# really is conservative can still be accepted: the floor is not a veto.
# Why: a reduced χ² far below 1 means the residuals are much smaller than the
# quoted uncertainties, which in reflectometry is almost always an overestimated
# dR column or a model with enough free parameters to absorb the noise. That is
# evidence about the ERROR BARS, not about the structure, so it must not read as a
# pass — your cue to check the dR column and the parameter count.
# The default 0.5 is the same number the built-in heuristic already calls
# "Possible overfitting". Set 0 to disable the floor. Must be finite, >= 0 and
# strictly less than CHI2_MAX; an unusable value here is logged and replaced (a
# floor at or above the ceiling is dropped to "no floor" so the run can still
# finish), while a setup YAML pinning both is rejected at load time. Precedence
# and pinning mirror CHI2_MAX.
# CHI2_MIN=0.5

# ── Data export ──────────────────────────────
# Export format for AI-ready data. Supported: "isaac"
# Leave empty or unset to disable the export button on the Results page.
# Requires: pip install aure[export]
# EXPORT_FORMAT=isaac

# ── LangSmith tracing (optional) ────────────
# Set to "true" to send traces to LangSmith for debugging / monitoring.
# Requires the langsmith package (pip install langsmith).
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=ls-...
# LANGCHAIN_PROJECT=aure
